.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# ---------------------------------------------------------------------------
# Forge dev workspace
#
# run/eula.txt and run/server.properties are intentionally kept: they are the dev
# settings, not generated output. The world, logs and crash reports are generated.
# ---------------------------------------------------------------------------
run/selftest/
run/world/
run/logs/
run/crash-reports/
run-data/
src/generated/resources/

# More of the dev workspace that is generated rather than written by hand. The eula and
# server.properties above are the exceptions: they are settings somebody chose.
run/config/
run/usercache.json
run/ops.json
run/whitelist.json
run/banned-ips.json
run/banned-players.json
hs_err_pid*.log
replay_pid*.log

